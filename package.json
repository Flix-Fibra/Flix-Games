{
  "name": "flix-games",
  "private": true,
  "version": "0.1.0",
  "description": "Mini games da plataforma Flix Games",
  "workspaces": ["packages/*", "games/*"],
  "scripts": {
    "dev:snake": "npm run dev -w games/snake",
    "build:snake": "npm run build -w games/snake",
    "dev:runner": "npm run dev -w games/runner",
    "build:runner": "npm run build -w games/runner",
    "dev:corrida": "npm run dev -w games/corrida",
    "build:corrida": "npm run build -w games/corrida",
    "dev:voo": "npm run dev -w games/voo",
    "build:voo": "npm run build -w games/voo",
    "dev:faixa": "npm run dev -w games/faixa",
    "build:faixa": "npm run build -w games/faixa",
    "dev:estoque": "npm run dev -w games/estoque",
    "build:estoque": "npm run build -w games/estoque",
    "catalogo": "node scripts/sincronizar-catalogo.mjs | docker compose exec -T db psql -v ON_ERROR_STOP=1 -q -U flixgames -d flixgames",
    "catalogo:conferir": "node scripts/sincronizar-catalogo.mjs --conferir",
    "dev:nestshoot": "npm run dev -w games/nestshoot",
    "build:nestshoot": "npm run build -w games/nestshoot",
    "personagem": "python3 scripts/personagem/montar.py",
    "dev:blocos": "npm run dev -w games/blocos",
    "build:blocos": "npm run build -w games/blocos",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
